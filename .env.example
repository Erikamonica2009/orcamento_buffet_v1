# Postgres
POSTGRES_USER=buffet
POSTGRES_PASSWORD=buffet_dev_password
POSTGRES_DB=orcamento_buffet

# Backend
NODE_ENV=development
BACKEND_PORT=3000
JWT_SECRET=dev-only-change-me
ADMIN_SEED_EMAIL=admin@buffet.com
ADMIN_SEED_PASSWORD=Admin@123

# Frontend
FRONTEND_PORT=5173

# Menor privilégio: usuário restrito que o backend usa para acessar o banco
APP_DB_USER=buffet_app
APP_DB_PASSWORD=troque-por-uma-senha-forte

# Criptografia em repouso: chaves de 256 bits (64 caracteres hex), diferentes entre si.
# Gere novas com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: perder DATA_ENCRYPTION_KEY torna CPF/telefone já gravados irrecuperáveis.
DATA_ENCRYPTION_KEY=gere-uma-chave-com-o-comando-acima
DATA_HASH_KEY=gere-outra-chave-com-o-comando-acima
